"SponsoredMessageInfoDescription1" = "دیگر ایپس کے برعکس، Telegram اشتہارات دکھانے کے لیے کبھی بھی آپ کا نجی ڈیٹا استعمال نہیں کرتا ہے۔ Telegram پر سپانسر شدہ پیغامات مکمل طور پر ان عوامی چینلز کے موضوع پر مبنی ہوتے ہیں جن میں وہ دکھائے جاتے ہیں۔ اس کا مطلب ہے کہ اشتہارات دکھانے کے لیے صارف کا کوئی ڈیٹا حاصل یا تجزیہ نہیں کیا جاتا ہے، اور Telegram پر کسی چینل کو دیکھنے والے ہر صارف کو وہی سپانسر شدہ پیغامات نظر آتے ہیں۔";
"SponsoredMessageInfoDescription2" = "دیگر ایپس کے برعکس، Telegram اس بات کو ٹریک نہیں کرتا ہے کہ آیا آپ نے کسی سپانسر شدہ پیغام پر ٹیپ کیا ہے اور آپ کی سرگرمی کی بنیاد پر آپ کا پروفائل تیار نہیں کرتا ہے۔ ہم سپانسر شدہ پیغامات میں بیرونی لنکس کو بھی روکتے ہیں تاکہ اس بات کو یقینی بنایا جا سکے کہ تیسرے فریق ہمارے صارفین کی جاسوسی نہ کر سکیں۔ ہمارا ماننا ہے کہ ہر ایک کو پرائیویسی کا حق حاصل ہے، اور تکنیکی پلیٹ فارمز کو اس کا احترام کرنا چاہیے۔";
"SponsoredMessageInfoDescription3" = "Telegram سیکڑوں ملین صارفین کو مفت اور لامحدود سروس پیش کرتا ہے، جس میں سرور اور ٹریفک کے اہم اخراجات شامل ہیں۔ خود مختار رہنے اور اپنی اقدار پر قائم رہنے کے لیے، Telegram نے صارف کی پرائیویسی کو مدنظر رکھتے ہوئے پیغامات کو فروغ دینے کے لیے ایک معاوضہ ٹول تیار کیا۔ ہم ذمہ دار مشتہرین کو خوش آمدید کہتے ہیں:";
"SponsoredMessageAlertLearnMoreUrl" = "https://ads.telegram.org";
"SponsoredMessageInfoDescription4" = "سپانسر شدہ پیغامات فی الحال ٹیسٹ موڈ میں ہیں۔ ایک بار جب وہ مکمل طور پر شروع ہو جائیں گے اور Telegram کو اپنے بنیادی اخراجات پورے کرنے کی اجازت دیں گے، تو ہم ان عوامی چینلز کے مالکان کے ساتھ اشتہاری آمدنی کا اشتراک شروع کریں گے جن میں سپانسر شدہ پیغامات دکھائے جاتے ہیں۔\n\nآن لائن اشتہارات کو اب صارف کی پرائیویسی کی خلاف ورزی کا مترادف نہیں ہونا چاہیے۔ آئیے مل کر نئی تعریف کریں کہ ایک ٹیک کمپنی کو کیسے کام کرنا چاہیے۔";
