"SponsoredMessageInfo" = "प्रायोजित संदेश\nक्या हैं?";
"SponsoredMessageInfoDescription1" = "अन्य ऐप्स के विपरीत, Telegram विज्ञापनों को लक्षित करने के लिए कभी भी आपके निजी डेटा का उपयोग नहीं करता है। Telegram पर प्रायोजित संदेश पूरी तरह से उन पब्लिक चैनलों के विषय पर आधारित होते हैं जिनमें वे दिखाए जाते हैं। इसका मतलब है कि विज्ञापन प्रदर्शित करने के लिए किसी भी यूज़र डेटा को माइन या विश्लेषित नहीं किया जाता है, और Telegram पर किसी चैनल को देखने वाले प्रत्येक यूज़र को वही प्रायोजित संदेश दिखाई देते हैं।";
"SponsoredMessageInfoDescription2" = "अन्य ऐप्स के विपरीत, Telegram यह ट्रैक नहीं करता है कि आपने किसी प्रायोजित संदेश पर टैप किया है या नहीं, और आपकी गतिविधि के आधार पर आपकी प्रोफ़ाइल नहीं बनाता है। हम यह सुनिश्चित करने के लिए प्रायोजित संदेशों में बाहरी लिंक को भी रोकते हैं कि तीसरे पक्ष हमारे यूज़र्स की जासूसी न कर सकें। हमारा मानना है कि गोपनीयता हर किसी का अधिकार है, और तकनीकी प्लेटफ़ॉर्म्स को इसका सम्मान करना चाहिए।";
"SponsoredMessageInfoDescription3" = "Telegram करोड़ों यूज़र्स को एक मुफ़्त और असीमित सेवा प्रदान करता है, जिसमें महत्वपूर्ण सर्वर और ट्रैफ़िक लागत शामिल होती है। स्वतंत्र रहने और अपने मूल्यों के प्रति सच्चे रहने के लिए, Telegram ने यूज़र गोपनीयता को ध्यान में रखते हुए संदेशों को बढ़ावा देने के लिए एक सशुल्क टूल विकसित किया है। हम ज़िम्मेदार विज्ञापनदाताओं का यहाँ स्वागत करते हैं:";
"SponsoredMessageAlertLearnMoreUrl" = "https://ads.telegram.org";
"SponsoredMessageInfoDescription4" = "प्रायोजित संदेश वर्तमान में परीक्षण मोड में हैं। एक बार जब वे पूरी तरह से लॉन्च हो जाएंगे और Telegram को अपनी बुनियादी लागतों को कवर करने की अनुमति देंगे, तो हम उन पब्लिक चैनलों के मालिकों के साथ विज्ञापन राजस्व साझा करना शुरू करेंगे जिनमें प्रायोजित संदेश प्रदर्शित होते हैं।\n\nऑनलाइन विज्ञापनों को अब यूज़र गोपनीयता के दुरुपयोग का पर्याय नहीं होना चाहिए। आइए हम मिलकर पुनर्परिभाषित करें कि एक टेक कंपनी को कैसे काम करना चाहिए।";
